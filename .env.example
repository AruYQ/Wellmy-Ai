# ==============================================================================
# Wellmy-Ai ("Jarvis Core") - Environment Configuration Template
# ==============================================================================
# Salin berkas ini menjadi '.env' di mesin lokal Anda:
#   copy .env.example .env
# PERINGATAN: DILARANG KERAS mem-push berkas '.env' asli ke Git! (Rule 01)
# ==============================================================================

# Google Gemini API Key (Resmi dari Google AI Studio)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Global Emergency Panic Hotkey (Format pynput: ctrl+shift+q)
PANIC_HOTKEY=ctrl+shift+q

# UI Theme (dark / light)
GUI_THEME=dark

# Level Logging Sistem (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Proteksi Sensor Otomatis Tangkapan Layar (True / False)
ENABLE_VISION_REDACTION=true

# Google Cloud TTS Credentials (Opsional jika menggunakan ADC lokal / file service account)
# GOOGLE_APPLICATION_CREDENTIALS=secrets/google_cloud_tts_key.json
